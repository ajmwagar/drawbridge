// meshcore-bridge Spore ABI.
//
// The Spore owns routing, owner policy, command replies and the order in which
// a transaction's effects are applied. The native Drawbridge host owns the
// appservice, sidecar HTTP, SQLite, credentials and retries.
package ajmwagar:meshcore-bridge@0.1.0;

world bridge {
  import ajmwagar:drawbridge/bridge@0.1.0;
  import wasi:cli/environment@0.2.4;

  /// Run the bridge loop with an explicit argument list. Used by a host that
  /// embeds this world directly.
  export run: func(args: list<string>) -> result<string, string>;

  /// The same loop as a normal Loam CLI command.
  export wasi:cli/run@0.2.4;
}
