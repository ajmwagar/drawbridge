(defun rf/presets ()
  (list
    (list (list :name "NOAA WX") (list :freq-label "162.550") (list :device "hackrf") (list :freq 162.55) (list :mode "NFM") (list :bw 12.5) (list :span 2) (list :note "Weather band · carrier centered"))
    (list (list :name "APRS") (list :freq-label "144.390") (list :device "hackrf") (list :freq 144.39) (list :mode "NFM") (list :bw 12.5) (list :span 0.5) (list :note "APRS · 1200 baud AFSK"))
    (list (list :name "AIS") (list :freq-label "161.975") (list :device "ais") (list :freq 161.975) (list :mode "NFM") (list :bw 25) (list :span 0.5) (list :note "Marine AIS · channel 1"))
    (list (list :name "ADS-B") (list :freq-label "1090.000") (list :device "adsb") (list :freq 1090) (list :mode "AM") (list :bw 200) (list :span 5) (list :note "1090 MHz · Mode-S / ADS-B"))
    (list (list :name "MeshCore") (list :freq-label "915.000") (list :device "meshcore") (list :freq 915) (list :mode "NFM") (list :bw 125) (list :span 2) (list :note "LoRa packet · 915 MHz"))))

(defun rf/events ()
  (list
    (list (list :time "14:02:11") (list :text "NOAA 7 carrier acquired on HackRF One"))
    (list (list :time "14:01:48") (list :text "MeshCore advert heard · 3 hops"))
    (list (list :time "13:59:22") (list :text "ADS-B track 0x4CA2B1 resolved"))
    (list (list :time "13:57:05") (list :text "RTL-SDR V3 returned to idle"))))

(defun rf/modes ()
  (list "AM" "NFM" "WFM" "USB" "LSB" "CW"))
