      (list :initial (rf/initial 533 "533.000" "AM" 200 0 -84 10 #f #f)))))

(defun rf/preset (name label group tag device freq mode bw span note)
  (list
    (list :name name)
    (list :freq-label label)
    (list :group group)
    (list :tag tag)
    (list :device device)
    (list :freq freq)
    (list :mode mode)
    (list :bw bw)
    (list :span span)
    (list :note note)))

