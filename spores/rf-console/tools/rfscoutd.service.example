[Unit]
Description=RF Console tinySA scout
After=network-online.target

[Service]
# Run as the user that owns the TinySA serial device. Add that user to the
# device's group (often dialout) or use a udev rule instead of root.
User=radioman
WorkingDirectory=/opt/rf-console
ExecStart=/usr/bin/python3 /opt/rf-console/tools/scoutd.py \
  --listen 0.0.0.0:8798 \
  --port /dev/ttyACM1 \
  --page /opt/rf-console/web/index.html \
  --antenna AR-771
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
